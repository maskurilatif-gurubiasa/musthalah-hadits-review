                                    <input type="text" id="inpB" oninput="updatePreview()" placeholder="Pilihan B" class="w-full border rounded p-2 text-sm">
                                    <input type="text" id="inpC" oninput="updatePreview()" placeholder="Pilihan C" class="w-full border rounded p-2 text-sm">
                                    <input type="text" id="inpD" oninput="updatePreview()" placeholder="Pilihan D" class="w-full border rounded p-2 text-sm">
