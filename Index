                            <button onclick="navQ(-1)" class="px-4 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 font-medium flex-1 md:flex-none flex items-center justify-center transition-colors"><i class="fas fa-chevron-left md:mr-2"></i><span class="hidden md:inline">Sebelumnya</span></button>
                            <button onclick="toggleDoubt()" id="btnRagu" class="px-4 py-3 bg-yellow-100 text-yellow-700 border border-yellow-400 rounded-lg hover:bg-yellow-200 font-medium flex-1 flex items-center justify-center transition-colors"><i class="fas fa-star mr-2"></i>Ragu-Ragu</button>
                            <button onclick="navQ(1)" class="px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium flex-1 md:flex-none flex items-center justify-center transition-colors"><span class="hidden md:inline">Selanjutnya</span><i class="fas fa-chevron-right md:ml-2"></i></button>
                        </div>
                    </div>

                    <!-- Panel 3: Navigasi (Kanan) -->
                    <div id="panelNav" class="w-full md:w-1/4 bg-white border-l border-gray-200 flex flex-col hidden md:flex absolute md:relative inset-0 z-20 h-full">
                        <div class="p-4 border-b flex justify-between items-center md:hidden shrink-0 bg-gray-50">
                            <h3 class="font-bold text-gray-700"><i class="fas fa-th mr-2"></i> Daftar Soal</h3>
                            <button onclick="togglePanels()" class="p-2 text-gray-500 hover:text-red-500"><i class="fas fa-times text-xl"></i></button>
                        </div>
                        <div class="p-4 border-b shrink-0 hidden md:block bg-gray-50">
                            <h3 class="text-sm font-bold text-gray-600 uppercase tracking-wider"><i class="fas fa-th mr-2"></i> Navigasi Soal</h3>
                        </div>
                        
                        <div class="p-4 overflow-y-auto flex-grow hide-scroll">
                            <div id="qGrid" class="grid grid-cols-5 gap-2 mb-6">
                                <!-- Grid injected here -->
                            </div>
                        </div>

                        <div class="p-4 mt-auto border-t bg-gray-50 shrink-0">
                            <div class="flex flex-wrap gap-2 text-xs mb-4 text-gray-600">
                                <div class="flex items-center"><div class="w-3 h-3 bg-blue-500 rounded-sm mr-1"></div> Dijawab</div>
                                <div class="flex items-center"><div class="w-3 h-3 bg-yellow-400 rounded-sm mr-1"></div> Ragu</div>
                                <div class="flex items-center"><div class="w-3 h-3 bg-white rounded-sm mr-1 border border-gray-300"></div> Kosong</div>
                            </div>
                            <button onclick="confirmSubmit()" class="w-full py-3 bg-green-500 hover:bg-green-600 text-white font-bold rounded-lg shadow-lg flex justify-center items-center transition-colors">
                                <i class="fas fa-paper-plane mr-2"></i> Selesai & Kirim
                            </button>
                        </div>
                    </div>
                </div>
            `;
            document.getElementById('app').innerHTML = html;
            loadQuestion(0);
            renderGrid();
        }

