<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT Application</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; user-select: none; }
        .hide-scroll::-webkit-scrollbar { display: none; }
        .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }
        /* Anti-select */
        * { -webkit-user-select: none; -khtml-user-select: none; -moz-user-select: none; -o-user-select: none; user-select: none; }
        input[type="text"], input[type="password"], textarea { -webkit-user-select: text; user-select: text; }
        
        .radio-custom:checked + label {
            background-color: #eff6ff;
            border-color: #3b82f6;
        }
    </style>
</head>
<body oncontextmenu="return false;">

    <!-- APP CONTAINER -->
    <div id="app" class="min-h-screen flex flex-col items-center justify-center bg-gray-100">
        <i class="fas fa-circle-notch fa-spin text-6xl text-blue-500 mb-4"></i>
        <h2 class="text-xl font-bold text-gray-700">Memuat Aplikasi...</h2>
        <p class="text-gray-500 mt-2" id="loadingStatus">Menghubungkan ke server database...</p>
    </div>

    <!-- GLOBAL MODAL -->
    <div id="globalModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6 text-center transform scale-95 transition-transform duration-300" id="modalContent">
            <div id="modalIcon" class="text-4xl mb-4 text-blue-500"><i class="fas fa-info-circle"></i></div>
            <h3 id="modalTitle" class="text-xl font-bold mb-2 text-gray-800">Judul</h3>
            <p id="modalMsg" class="text-gray-600 mb-6">Pesan</p>
            <div class="flex justify-center gap-3" id="modalButtons">
                <button id="modalBtnOk" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">OK</button>
            </div>
        </div>
    </div>

    <script>
        // ==========================================
        // STATE MANAGEMENT
        // ==========================================
        const state = {
            config: {},
            view: 'login', // login, student, admin, result
            user: null, // {nama, kelas}
            questions: [],
            answers: {},
            doubts: {},
            currentQIdx: 0,
            violations: 0,
            timer: 0,
            timerInterval: null
        };

        // ==========================================
        // INIT & ANTI-CHEAT
        // ==========================================
        window.onload = () => {
            // Get config from backend
            google.script.run
                .withSuccessHandler(res => {
                    state.config = res;
                    renderLogin();
                })
                .withFailureHandler(err => {
                    document.getElementById('loadingStatus').innerHTML = `<span class="text-red-500 font-bold">Error: ${err.message}</span>`;
                    showModal("Koneksi Gagal", "Gagal memuat aplikasi. Pastikan link yang dibuka benar dan izin akses telah disetel ke 'Semua Orang'.", "error");
                })
                .getConfig();

            // Anti-cheat: Visibility & Keyboard
            document.addEventListener('visibilitychange', () => {
                if (document.hidden && state.view === 'student') {
                    state.violations++;
                    showModal("PERINGATAN!", `Anda terdeteksi berpindah tab/jendela. Pelanggaran tercatat: ${state.violations} kali. Ujian dapat dibatalkan jika terus melanggar.`, "warning");
                }
            });

            document.addEventListener('keydown', (e) => {
                if(e.key === 'F12' || (e.ctrlKey && e.shiftKey && e.key === 'I')) {
                    e.preventDefault();
                    if(state.view === 'student') {
                        state.violations++;
                        showModal("Akses Ditolak", "Fitur ini dinonaktifkan selama ujian.", "error");
                    }
                }
            });
        };

        // ==========================================
        // UI COMPONENTS & RENDERERS
        // ==========================================
        function renderLogin() {
            state.view = 'login';
            const html = `
                <div class="flex-grow flex items-center justify-center p-4">
                    <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl flex flex-col md:flex-row overflow-hidden">
                        <div class="bg-blue-600 p-8 text-white flex flex-col justify-center items-center md:w-5/12">
                            <i class="fas fa-graduation-cap text-6xl mb-4"></i>
                            <h1 class="text-2xl font-bold text-center mb-2">${state.config.judul || 'CBT System'}</h1>
                            <p class="text-blue-100 text-center">${state.config.sekolah || ''}</p>
                            <p class="mt-8 text-sm opacity-80 text-center"><i class="fas fa-clock mr-2"></i>Durasi: ${state.config.durasi_menit || 90} Menit</p>
                        </div>
                        <div class="p-8 md:w-7/12">
                            <div class="flex border-b mb-6">
                                <button onclick="switchLoginTab('siswa')" id="tabSiswa" class="w-1/2 py-3 text-center border-b-2 border-blue-600 font-bold text-blue-600">Login Siswa</button>
                                <button onclick="switchLoginTab('admin')" id="tabAdmin" class="w-1/2 py-3 text-center border-b-2 border-transparent font-medium text-gray-500">Guru / Admin</button>
                            </div>
                            
                            <!-- Form Siswa -->
                            <div id="formSiswa">
                                <div class="mb-4">
                                    <label class="block text-gray-700 text-sm font-bold mb-2">Nama Lengkap</label>
                                    <input type="text" id="loginNama" class="w-full px-4 py-3 rounded-lg bg-gray-100 border-transparent focus:border-blue-500 focus:bg-white focus:ring-0" placeholder="Masukkan nama..." required>
                                </div>
                                <div class="mb-6">
                                    <label class="block text-gray-700 text-sm font-bold mb-2">Token Akses</label>
                                    <input type="password" id="loginToken" class="w-full px-4 py-3 rounded-lg bg-gray-100 border-transparent focus:border-blue-500 focus:bg-white focus:ring-0" placeholder="Masukkan token..." required>
                                </div>
                                <button onclick="doLoginSiswa()" id="btnSiswa" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition duration-200">
                                    Mulai Ujian
                                </button>
                            </div>

                            <!-- Form Admin -->
                            <div id="formAdmin" class="hidden">
                                <div class="mb-6">
                                    <label class="block text-gray-700 text-sm font-bold mb-2">Password Admin</label>
                                    <input type="password" id="loginPassAdmin" class="w-full px-4 py-3 rounded-lg bg-gray-100 border-transparent focus:border-blue-500 focus:bg-white focus:ring-0" placeholder="Password...">
                                </div>
                                <button onclick="doLoginAdmin()" id="btnAdmin" class="w-full bg-gray-800 hover:bg-gray-900 text-white font-bold py-3 px-4 rounded-lg transition duration-200">
                                    Masuk Dashboard
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            document.getElementById('app').innerHTML = html;
        }

        function switchLoginTab(tab) {
            if(tab === 'siswa') {
                document.getElementById('tabSiswa').className = "w-1/2 py-3 text-center border-b-2 border-blue-600 font-bold text-blue-600";
                document.getElementById('tabAdmin').className = "w-1/2 py-3 text-center border-b-2 border-transparent font-medium text-gray-500";
                document.getElementById('formSiswa').classList.remove('hidden');
                document.getElementById('formAdmin').classList.add('hidden');
            } else {
                document.getElementById('tabAdmin').className = "w-1/2 py-3 text-center border-b-2 border-blue-600 font-bold text-blue-600";
                document.getElementById('tabSiswa').className = "w-1/2 py-3 text-center border-b-2 border-transparent font-medium text-gray-500";
                document.getElementById('formAdmin').classList.remove('hidden');
                document.getElementById('formSiswa').classList.add('hidden');
            }
        }

        function renderStudentApp() {
