                                <button onclick="simpanSoal()" class="w-full bg-blue-600 text-white py-2 rounded shadow hover:bg-blue-700">Simpan ke Database</button>
                            </div>
                            
                            <div class="xl:w-1/2 bg-gray-50 border-2 border-dashed border-gray-300 rounded-xl p-6 relative">
                                <span class="absolute top-0 right-0 bg-gray-300 text-gray-600 text-xs px-2 py-1 rounded-bl-lg">Live Preview</span>
                                <div class="bg-white rounded-lg shadow-sm border p-6 mt-4">
