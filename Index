        // ==========================================
        // CONTROLLERS & LOGIC
        // ==========================================
        function doLoginSiswa() {
            const nama = document.getElementById('loginNama').value;
            const token = document.getElementById('loginToken').value;
            
            if(!nama || !token) {
                showModal("Error", "Nama dan Token harus diisi!", "error");
                return;
            }

            const btn = document.getElementById('btnSiswa');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifikasi...';
            btn.disabled = true;

            google.script.run.withSuccessHandler(res => {
                if(res.success) {
                    state.user = { nama: res.nama, kelas: res.kelas };
                    fetchQuestions();
                } else {
                    showModal("Login Gagal", res.message, "error");
                    btn.innerHTML = 'Mulai Ujian';
                    btn.disabled = false;
                }
            }).verifyStudentLogin(nama, token);
        }

        function doLoginAdmin() {
            const pass = document.getElementById('loginPassAdmin').value;
            google.script.run.withSuccessHandler(res => {
                if(res.success) {
                    renderAdminDashboard();
                } else {
                    showModal("Akses Ditolak", res.message, "error");
                }
            }).verifyAdminLogin(pass);
        }

        function fetchQuestions() {
            google.script.run.withSuccessHandler(res => {
                if(res && res.length > 0) {
                    state.questions = res;
                    // Try load local storage
                    const saved = localStorage.getItem(`cbt_${state.user.nama}_ans`);
                    if(saved) {
                        try { state.answers = JSON.parse(saved); } catch(e){}
                    }
                    renderStudentApp();
                    startTimer();
                } else {
                    showModal("Error", "Tidak ada soal tersedia di database.", "error");
                    document.getElementById('btnSiswa').innerHTML = 'Mulai Ujian';
                    document.getElementById('btnSiswa').disabled = false;
                }
            }).getQuestionsForStudent();
        }

        function startTimer() {
            // Check localstorage for remaining time
            const savedTime = localStorage.getItem(`cbt_${state.user.nama}_time`);
            let duration = state.config.durasi_menit * 60;
            
            if (savedTime && !isNaN(savedTime)) {
                duration = parseInt(savedTime);
            }
            
            state.timer = duration;
            updateTimerDisplay();

            state.timerInterval = setInterval(() => {
                state.timer--;
                updateTimerDisplay();
                
                // Save time every 5 secs
                if(state.timer % 5 === 0) localStorage.setItem(`cbt_${state.user.nama}_time`, state.timer);

                if(state.timer <= 0) {
                    clearInterval(state.timerInterval);
                    showModal("Waktu Habis!", "Waktu ujian Anda telah habis. Jawaban akan dikirim otomatis.", "warning", () => {
                        processSubmit();
                    });
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const h = Math.floor(state.timer / 3600);
            const m = Math.floor((state.timer % 3600) / 60);
            const s = state.timer % 60;
            document.getElementById('timerDisplay').innerText = 
                `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }

        // ==========================================
        // STUDENT INTERACTION LOGIC
        // ==========================================
        function loadQuestion(idx) {
            if(idx < 0 || idx >= state.questions.length) return;
            state.currentQIdx = idx;
            const q = state.questions[idx];

            // Render Stimulus (Statis Layout)
            const cStimulus = document.getElementById('stimulusContent');
            if(q.Teks_Stimulus || q.Gambar_Stimulus_URL) {
                cStimulus.innerHTML = (q.Gambar_Stimulus_URL ? `<img src="${q.Gambar_Stimulus_URL}" class="mb-3 w-full rounded shadow-sm border">` : '') + 
                                      (q.Teks_Stimulus ? `<p>${q.Teks_Stimulus}</p>` : '');
            } else {
                cStimulus.innerHTML = `<div class="flex flex-col items-center justify-center h-48 text-gray-400 mt-10"><i class="fas fa-file-alt text-4xl mb-3 opacity-30"></i><p class="text-sm italic text-center">Tidak ada stimulus/informasi tambahan untuk soal ini.</p></div>`;
            }

            // Render Soal
            document.getElementById('qNumber').innerText = `Soal No. ${q.Nomor_Soal}`;
            document.getElementById('qBobot').innerText = `Bobot: ${q.Bobot}`;
            document.getElementById('qText').innerHTML = q.Teks_Soal;
            
            const imgEl = document.getElementById('qImage');
            if(q.Gambar_Soal_URL) {
                imgEl.src = q.Gambar_Soal_URL;
                imgEl.classList.remove('hidden');
            } else {
                imgEl.classList.add('hidden');
            }

            // Render Pilihan
            const optsContainer = document.getElementById('qOptions');
            optsContainer.innerHTML = '';
            ['A', 'B', 'C', 'D'].forEach(opt => {
                const text = q[`Pilihan_${opt}`];
                if(text) {
                    const isChecked = state.answers[q.ID_Soal] === opt;
                    optsContainer.innerHTML += `
                        <div class="relative">
                            <input type="radio" name="opsi" id="opt${opt}" value="${opt}" class="peer hidden radio-custom" ${isChecked ? 'checked' : ''} onchange="saveAnswer('${q.ID_Soal}', '${opt}')">
                            <label for="opt${opt}" class="flex items-start gap-4 p-4 border-2 border-gray-200 rounded-xl cursor-pointer transition-all hover:bg-gray-50 text-gray-700">
                                <div class="w-7 h-7 rounded-full border-2 border-gray-300 flex items-center justify-center font-bold text-sm shrink-0 peer-checked:bg-blue-500 peer-checked:text-white peer-checked:border-blue-500 transition-colors label-circle">${opt}</div>
                                <div class="pt-0.5 leading-tight">${text}</div>
                            </label>
                        </div>
                    `;
                }
            });

            // Update UI Button Ragu
            const btnRagu = document.getElementById('btnRagu');
            if(state.doubts[q.ID_Soal]) {
                btnRagu.classList.remove('bg-yellow-100', 'text-yellow-700');
                btnRagu.classList.add('bg-yellow-500', 'text-white');
            } else {
                btnRagu.classList.add('bg-yellow-100', 'text-yellow-700');
                btnRagu.classList.remove('bg-yellow-500', 'text-white');
            }

            renderGrid();
        }

        function saveAnswer(qId, val) {
            state.answers[qId] = val;
            localStorage.setItem(`cbt_${state.user.nama}_ans`, JSON.stringify(state.answers));
            
            // Highlight selected visual dynamically
            document.querySelectorAll('.label-circle').forEach(el => {
                el.classList.remove('bg-blue-500', 'text-white', 'border-blue-500');
            });
            const selectedRadio = document.querySelector('input[name="opsi"]:checked');
            if(selectedRadio) {
                const circle = selectedRadio.nextElementSibling.querySelector('.label-circle');
                circle.classList.add('bg-blue-500', 'text-white', 'border-blue-500');
            }

            renderGrid();
        }

        function toggleDoubt() {
            const q = state.questions[state.currentQIdx];
            state.doubts[q.ID_Soal] = !state.doubts[q.ID_Soal];
            loadQuestion(state.currentQIdx); // refresh btn
        }

        function navQ(dir) {
            let next = state.currentQIdx + dir;
            if(next >= 0 && next < state.questions.length) loadQuestion(next);
        }

        function renderGrid() {
            const grid = document.getElementById('qGrid');
            grid.innerHTML = '';
            state.questions.forEach((q, idx) => {
                let bgClass = "bg-gray-100 text-gray-600 border-gray-300"; // Belum
                if (state.answers[q.ID_Soal]) bgClass = "bg-blue-500 text-white border-blue-600"; // Dijawab
                if (state.doubts[q.ID_Soal]) bgClass = "bg-yellow-400 text-white border-yellow-500"; // Ragu

                let activeRing = idx === state.currentQIdx ? "ring-2 ring-offset-2 ring-blue-800 font-bold scale-110" : "";

                grid.innerHTML += `
                    <button onclick="loadQuestion(${idx})" class="w-10 h-10 flex items-center justify-center rounded border shadow-sm text-sm transition-all ${bgClass} ${activeRing}">
                        ${q.Nomor_Soal}
                    </button>
                `;
            });
        }

        function togglePanels() {
            const nav = document.getElementById('panelNav');
            if(nav.classList.contains('hidden')) {
                nav.classList.remove('hidden');
            } else {
                nav.classList.add('hidden');
            }
        }

        // ==========================================
        // SUBMIT EXAM
        // ==========================================
        function confirmSubmit() {
            const total = state.questions.length;
            const answered = Object.keys(state.answers).length;
            const msg = answered < total ? 
                `Anda baru menjawab ${answered} dari ${total} soal. Yakin ingin mengirim sekarang?` : 
                `Anda sudah menjawab semua soal. Yakin ingin menyelesaikan ujian?`;
            
            showModal("Konfirmasi", msg, "warning", () => {
                processSubmit();
            });
        }

        function processSubmit() {
            clearInterval(state.timerInterval);
            
            // Show loading overlay
            document.getElementById('app').innerHTML = `
                <div class="flex-grow flex flex-col items-center justify-center bg-white h-screen">
                    <i class="fas fa-circle-notch fa-spin text-6xl text-blue-500 mb-4"></i>
                    <h2 class="text-xl font-bold text-gray-700">Memproses Nilai...</h2>
                    <p class="text-gray-500 mt-2">Mohon jangan tutup jendela ini.</p>
                </div>
            `;

            google.script.run.withSuccessHandler(res => {
                // Clear local storage
                localStorage.removeItem(`cbt_${state.user.nama}_ans`);
                localStorage.removeItem(`cbt_${state.user.nama}_time`);
                
                // Show Result Screen
                state.view = 'result';
                document.getElementById('app').innerHTML = `
                    <div class="flex-grow flex items-center justify-center bg-gray-100 p-4">
                        <div class="bg-white p-8 rounded-2xl shadow-xl max-w-lg w-full text-center">
                            <div class="w-24 h-24 bg-green-100 text-green-500 rounded-full flex items-center justify-center text-5xl mx-auto mb-6">
                                <i class="fas fa-check"></i>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-800 mb-2">Ujian Selesai!</h2>
                            <p class="text-gray-600 mb-6">Terima kasih ${state.user.nama}, jawaban Anda telah tersimpan.</p>
                            
                            <div class="grid grid-cols-2 gap-4 mb-8">
                                <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
                                    <p class="text-xs text-blue-600 font-bold uppercase">Nilai Akhir</p>
                                    <p class="text-3xl font-black text-blue-800">${res.nilaiAkhir}</p>
                                </div>
                                <div class="bg-gray-50 p-4 rounded-xl border flex flex-col justify-center">
                                    <p class="text-sm font-medium text-gray-600">Benar: <span class="text-green-600 font-bold">${res.benar}</span></p>
                                    <p class="text-sm font-medium text-gray-600">Salah: <span class="text-red-500 font-bold">${res.salah}</span></p>
                                </div>
                            </div>
                            
                            <button onclick="window.location.reload()" class="bg-gray-800 text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-900 w-full shadow-lg">Kembali ke Beranda</button>
                        </div>
                    </div>
                `;
            }).submitStudentExam(state.user, state.answers, state.violations);
        }


        // ==========================================
        // ADMIN LOGIC
        // ==========================================
        function switchAdminTab(tab) {
            const vInput = document.getElementById('adminInputView');
            const vRekap = document.getElementById('adminRekapView');
            const mInput = document.getElementById('tabMenuInput');
            const mRekap = document.getElementById('tabMenuRekap');

            if(tab === 'input') {
                vInput.classList.remove('hidden'); vRekap.classList.add('hidden');
                mInput.className = "p-4 text-left border-l-4 border-blue-500 bg-gray-800 text-white";
                mRekap.className = "p-4 text-left border-l-4 border-transparent hover:bg-gray-800 hover:text-white";
            } else {
                vInput.classList.add('hidden'); vRekap.classList.remove('hidden');
                mRekap.className = "p-4 text-left border-l-4 border-blue-500 bg-gray-800 text-white";
                mInput.className = "p-4 text-left border-l-4 border-transparent hover:bg-gray-800 hover:text-white";
                loadRekap();
            }
        }

        function updatePreview() {
            const stim = document.getElementById('inpStimulus').value;
            const pStim = document.getElementById('prevStimulus');
            if(stim) { pStim.innerHTML = stim; pStim.classList.remove('hidden'); }
            else { pStim.classList.add('hidden'); }

            document.getElementById('prevSoal').innerText = document.getElementById('inpSoal').value || "[Pertanyaan akan muncul di sini]";
            document.getElementById('prevA').innerText = document.getElementById('inpA').value;
            document.getElementById('prevB').innerText = document.getElementById('inpB').value;
            document.getElementById('prevC').innerText = document.getElementById('inpC').value;
            document.getElementById('prevD').innerText = document.getElementById('inpD').value;
        }

        function simpanSoal() {
            const qData = {
                Nomor_Soal: document.getElementById('inpNo').value,
                Jenis_Soal: document.getElementById('inpJenis').value,
                Teks_Stimulus: document.getElementById('inpStimulus').value,
                Gambar_Stimulus_URL: "", // Placeholder if future implementation needed
                Teks_Soal: document.getElementById('inpSoal').value,
                Gambar_Soal_URL: "",
                Pilihan_A: document.getElementById('inpA').value,
                Pilihan_B: document.getElementById('inpB').value,
                Pilihan_C: document.getElementById('inpC').value,
                Pilihan_D: document.getElementById('inpD').value,
                Kunci_Jawaban: document.getElementById('inpKunci').value,
                Pembahasan: "", // Opsional admin input form simplified
                Bobot: document.getElementById('inpBobot').value
            };

            if(!qData.Teks_Soal || !qData.Pilihan_A || !qData.Pilihan_B) {
                showModal("Error", "Soal dan minimal pilihan A & B harus diisi!", "error");
                return;
            }

            google.script.run.withSuccessHandler(res => {
                showModal("Sukses", res.message, "success");
                document.getElementById('inpNo').value = parseInt(qData.Nomor_Soal) + 1;
                document.getElementById('inpSoal').value = "";
                document.getElementById('inpA').value = "";
                document.getElementById('inpB').value = "";
                document.getElementById('inpC').value = "";
                document.getElementById('inpD').value = "";
                updatePreview();
            }).saveSingleQuestion(qData);
        }

        function loadRekap() {
            document.getElementById('rekapTableBody').innerHTML = '<tr><td colspan="6" class="px-6 py-4 text-center"><i class="fas fa-spinner fa-spin mr-2"></i>Memuat data...</td></tr>';
            
            google.script.run.withSuccessHandler(data => {
                const tbody = document.getElementById('rekapTableBody');
                if(!data || data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-4 text-center">Belum ada data hasil ujian.</td></tr>';
                    return;
                }
                
                let html = '';
                data.forEach(r => {
                    const date = new Date(r.waktu).toLocaleString('id-ID');
                    html += `
                        <tr class="bg-white border-b hover:bg-gray-50">
                            <td class="px-6 py-4">${date}</td>
                            <td class="px-6 py-4 font-medium text-gray-900">${r.nama}</td>
                            <td class="px-6 py-4">${r.kelas}</td>
                            <td class="px-6 py-4 text-center font-bold text-blue-600">${r.nilai}</td>
                            <td class="px-6 py-4 text-center">${r.benar} / ${r.salah}</td>
                            <td class="px-6 py-4 text-center"><span class="px-2 py-1 rounded text-xs font-bold ${r.pelanggaran > 0 ? 'bg-red-100 text-red-600' : 'bg-green-100 text-green-600'}">${r.pelanggaran}</span></td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            }).getExamResultsForAdmin();
        }

        // ==========================================
        // CUSTOM MODAL (REPLACEMENT FOR ALERT)
        // ==========================================
        function showModal(title, msg, type = 'info', callback = null) {
            const modal = document.getElementById('globalModal');
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMsg').innerText = msg;
            
            const icon = document.getElementById('modalIcon');
            if(type === 'error') icon.innerHTML = '<i class="fas fa-times-circle text-red-500"></i>';
            else if(type === 'warning') icon.innerHTML = '<i class="fas fa-exclamation-triangle text-yellow-500"></i>';
            else if(type === 'success') icon.innerHTML = '<i class="fas fa-check-circle text-green-500"></i>';
            else icon.innerHTML = '<i class="fas fa-info-circle text-blue-500"></i>';

            const btn = document.getElementById('modalBtnOk');
            btn.onclick = () => {
                modal.classList.add('hidden');
                if(callback) callback();
            };

            modal.classList.remove('hidden');
        }

    </script>
</body>
</html>
