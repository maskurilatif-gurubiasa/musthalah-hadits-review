                    <button onclick="renderLogin()" class="bg-red-500 hover:bg-red-600 px-4 py-2 rounded text-sm"><i class="fas fa-sign-out-alt mr-2"></i>Logout</button>
                </nav>
                <div class="flex flex-grow h-[calc(100vh-68px)] overflow-hidden">
                    <!-- Sidebar -->
                    <div class="w-64 bg-gray-900 text-gray-300 flex flex-col">
                        <button onclick="switchAdminTab('input')" id="tabMenuInput" class="p-4 text-left border-l-4 border-blue-500 bg-gray-800 text-white"><i class="fas fa-edit mr-3"></i>Input Soal</button>
                        <button onclick="switchAdminTab('rekap')" id="tabMenuRekap" class="p-4 text-left border-l-4 border-transparent hover:bg-gray-800 hover:text-white"><i class="fas fa-table mr-3"></i>Rekap Nilai</button>
                    </div>

                    <!-- Content Area -->
                    <div class="flex-grow bg-gray-100 overflow-y-auto p-6" id="adminContent">
