                                <h2 class="text-lg font-bold mb-4 border-b pb-2">Form Tambah Soal</h2>
                                <div class="grid grid-cols-2 gap-4 mb-4">
                                    <div><label class="text-xs font-bold text-gray-600">Nomor Soal</label><input type="number" id="inpNo" class="w-full border rounded p-2 text-sm mt-1" value="1"></div>
                                    <div><label class="text-xs font-bold text-gray-600">Jenis Soal</label><select id="inpJenis" class="w-full border rounded p-2 text-sm mt-1"><option value="PG">Pilihan Ganda</option></select></div>
